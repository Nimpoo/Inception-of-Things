Vagrant.configure("2") do |config|
  # * Provider-specific configuration
  config.vm.provider :libvirt do |libvirt|
    # * 2GB of memory
    libvirt.memory = 2048
    # * 2 cores
    libvirt.cpus = 2
    libvirt.qemu_use_session = false
    libvirt.driver = "kvm"
  end

  # * Box distribution
  config.vm.box = "generic/ubuntu2204"
  config.vm.box_version = "4.3.12"

  # * NFS synced folder configuration
  config.vm.synced_folder "synced_folder_nfs/", "/synced_folder_nfs/",
    type: "nfs",
    nfs_version: 4

	# * Provisioning all VMs
  config.vm.provision "upgrade and firewall",
    type: "shell",
    privileged: true,
    before: :all,

    inline: <<-SHELL
    echo "[upgrade and firewall provision] Upgrading system packages..."
    sudo apt-get --fix-broken install -y
    sudo apt-get update
    sudo apt-get upgrade -y

    ufw allow 6443/tcp #apiserver
    ufw allow from 10.42.0.0/16 to any #pods
    ufw allow from 10.43.0.0/16 to any #services
  SHELL

  # * Base box configuration
  config.vm.define "noalexanS" do |noalexanS|
    noalexanS.vm.hostname = "noalexanS"

    # * Network configuration
    noalexanS.vm.network :private_network, ip: "192.168.56.110",
      libvirt__host_ip: "192.168.56.1",
      libvirt__network_name: "vagrant-libvirt-p1",
      libvirt__dhcp_enabled: false

    # * K3s installation in controller mode
    noalexanS.vm.provision "k3s - controller mode",
      type: "shell",

      inline: <<-SHELL
      echo "[k3s provision] Installing k3s in controller mode (creation of the cluster)..."
      curl -sfL https://get.k3s.io | sh -
      cp -fv /var/lib/rancher/k3s/server/node-token /synced_folder_nfs/
      sudo chown -v vagrant:vagrant /etc/rancher/k3s/k3s.yaml
    SHELL
  end

  config.vm.define "mayoubSW" do |mayoubSW|
    mayoubSW.vm.hostname = "mayoubSW"

    # * Network configuration
    mayoubSW.vm.network :private_network, ip: "192.168.56.111",
      libvirt__host_ip: "192.168.56.1",
      libvirt__network_name: "vagrant-libvirt-p1",
      libvirt__dhcp_enabled: false

    # * K3s installation in agent mode
    mayoubSW.vm.provision "k3s - agent mode",
      type: "shell",

      inline: <<-SHELL
      export SECONDS=0
      echo "[k3s provision] Installing k3s in agent mode..."

      while [ ! -e /synced_folder_nfs/node-token ]; do
        echo "[k3s provision] Waiting about $SECONDS seconds for node-token to be available..."
        sleep 10
        export SECONDS=$((SECONDS+10))
      done

      export K3S_TOKEN=$(cat /synced_folder_nfs/node-token)
      echo "[k3s provision] Has waited for $SECONDS seconds."
      curl -sfL https://get.k3s.io | K3S_URL=https://192.168.56.110:6443 K3S_TOKEN=$K3S_TOKEN sh -
    SHELL
  end
end
